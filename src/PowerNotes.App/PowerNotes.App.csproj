<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PowerNotes.Core\PowerNotes.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Product>PowerNotes</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\powernotes.ico</ApplicationIcon>
    <AssemblyName>PowerNotes</AssemblyName>
    <RootNamespace>PowerNotes.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\powernotes.ico" />
  </ItemGroup>

</Project>
