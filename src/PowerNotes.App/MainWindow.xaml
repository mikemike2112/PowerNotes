<Window x:Class="PowerNotes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:PowerNotes.App"
        Title="PowerNotes" Icon="Assets/powernotes.ico" Width="1500" Height="900" MinWidth="700" MinHeight="500" WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" Background="{DynamicResource BgBrush}">
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- titolo -->
            <RowDefinition Height="Auto"/>   <!-- schede -->
            <RowDefinition Height="Auto"/>   <!-- ribbon -->
            <RowDefinition Height="*"/>      <!-- righelli + documento -->
            <RowDefinition Height="Auto"/>   <!-- stato -->
        </Grid.RowDefinitions>

        <!-- barra del titolo -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="40" Background="{DynamicResource BgBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="QuickBar" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Height="30" MinWidth="90" MaxWidth="460" Margin="10,0" CornerRadius="5" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" VerticalAlignment="Center">
                <Grid>
                    <ContentControl x:Name="SearchIcon" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Margin="34,0,6,0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" ToolTip="Cerca comandi o testo (Invio)"/>
                    <TextBlock x:Name="SearchHint" Margin="38,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Text="Cerca" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" x:Name="CaptionButtons"/>
        </Grid>

        <!-- riga schede -->
        <StackPanel x:Name="TabRow" Grid.Row="1" Orientation="Horizontal" Margin="10,2,0,0" Height="34" Background="{DynamicResource BgBrush}"/>

        <!-- ribbon -->
        <Border x:Name="RibbonFrame" Grid.Row="2" Margin="8,2,8,4" CornerRadius="8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Height="126">
            <Grid>
                <ContentControl x:Name="RibbonHost" Margin="4,4,28,2"/>
                <Button x:Name="CollapseBtn" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" MinWidth="20" Padding="2" ToolTip="Comprimi il ribbon"/>
            </Grid>
        </Border>

        <!-- righelli e foglio -->
        <Grid Grid.Row="3" Background="{DynamicResource DeskBrush}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavCol" Width="0"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="NavPane" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Navigazione" FontWeight="SemiBold" Margin="12,10,12,6"/>
                    <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}"/>
                </DockPanel>
            </Border>
            <app:Ruler x:Name="HRuler" Grid.Row="0" Grid.Column="2" Height="22"/>
            <app:Ruler x:Name="VRuler" Grid.Row="1" Grid.Column="1" Width="22" Vertical="True"/>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" Grid.Column="2" Background="{DynamicResource DeskBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                <app:DocumentView x:Name="View"/>
            </ScrollViewer>
        </Grid>

        <!-- barra di stato -->
        <Border Grid.Row="4" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,3" Height="22">
                <StackPanel x:Name="ZoomBar" DockPanel.Dock="Right" Orientation="Horizontal"/>
                <StackPanel x:Name="ViewBar" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,24,0"/>
                <TextBlock x:Name="PageText" Margin="0,0,18,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="WordsText" Margin="0,0,18,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Italiano (Italia)" Margin="0,0,18,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="ZoomText" Visibility="Collapsed"/>
            </DockPanel>
        </Border>

        <!-- scheda File a tutta pagina -->
        <Grid x:Name="FilePage" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" Background="{DynamicResource PanelBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <StackPanel x:Name="FileNav" Margin="8,10"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="48,36">
                <TextBlock x:Name="FileTitle" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="FileInfo" Margin="0,14,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="14"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
